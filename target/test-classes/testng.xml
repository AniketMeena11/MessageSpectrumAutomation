<?xml version="1.0" encoding="UTF-8"?>
<suite name=" Message Spectrum Suite" verbose="1">

    <parameter name="browser" value="chrome"/>

    <test name="TC001 - Generate Password">
        <classes>
            <class name="com.messagespectrum.tests.SecretLinkTest">
                <methods>
                    <!-- Generate Password -->
                    <include name="TC_001_GeneratePassword"/>
                    <include name="TC_002_EachClickGeneratesDifferentPassword"/>
                    <include name="TC_003_GeneratedPasswordMeetsSecurityStandards"/>
                    <include name="TC_004_AutoGeneratedPasswordWorksWithLinkFlow"/>

                    <!-- Body Area -->
                    <include name="TC_005_BodyAreaAcceptsText"/>
                    <include name="TC_006_BodyAreaAcceptsSpecialCharsAndEmoji"/>
                    <include name="TC_008_BodyAreaHandlesLargeText"/>

                    <!-- Expires -->
                    <include name="TC_009_ExpiryDropdownContainsAllOptions"/>
                    <include name="TC_010_SelectCustomShowsInputBox"/>
                    <include name="TC_011_CustomExpiryZeroShowsError"/>
                    <include name="TC_013_DefaultExpiryIsPreSelected"/>
                    
                    <include name="TC_017_WarningMessageWhenMultipleViewsUnchecked"/>
					<include name="TC_018_WarningMessageWhenMultipleViewsChecked"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>